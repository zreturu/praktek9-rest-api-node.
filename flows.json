  {
    "id": "f_thr_put",
    "type": "function",
    "name": "Validasi + set threshold",
    "func": "const v = Number(msg.payload && msg.payload.threshold);\nif (!isFinite(v) || v < -50 || v > 150) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Body harus JSON: {\\\"threshold\\\": <angka -50..150>}\" };\n    return [null, msg, null];\n}\nflow.set(\"threshold\", v);\nconst last = flow.get(\"last\");\nconst wsMsgs = [{ payload: JSON.stringify({ type: \"threshold\", threshold: v }) }];\nif (last && last.temp > v) {\n    const message = `Suhu ${last.temp}\\u00B0C melewati batas ${v}\\u00B0C`;\n    wsMsgs.push({ payload: JSON.stringify({ type: \"alert\", ts: new Date().toISOString(), temp: last.temp, threshold: v, message }) });\n    node.warn(message);\n}\nmsg.statusCode = 200;\nmsg.payload = { threshold: v, message: \"Batas suhu diperbarui\" };\nreturn [msg, null, wsMsgs];",
    "outputs": 3,
    "timeout": 0,
