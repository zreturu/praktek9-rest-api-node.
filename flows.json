  {
    "id": "t_dash",
    "type": "template",
    "name": "Halaman dashboard",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Dashboard Suhu Real-time</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4\"></script>\n<style>\n  body{font-family:system-ui,sans-serif;margin:0;background:#f4f6f8;color:#222}\n  header{background:#1e293b;color:#fff;padding:14px 20px;display:flex;justify-content:space-between;align-items:center}\n  main{max-width:900px;margin:20px auto;padding:0 16px}\n  .card{background:#fff;border-radius:10px;padding:16px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,0,0,.1)}\n  .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}\n  .big{font-size:2.4rem;font-weight:700}\n  input{padding:8px;border:1px solid #cbd5e1;border-radius:6px}\n  button{padding:8px 14px;border:0;border-radius:6px;background:#2563eb;color:#fff;cursor:pointer}\n  #alert{display:none;background:#dc2626;color:#fff;padding:12px;border-radius:8px;margin-bottom:16px;font-weight:600}\n  #ws{font-size:.85rem;padding:3px 10px;border-radius:20px;background:#64748b}\n  #ws.on{background:#16a34a}\n</style>\n</head>\n<body>\n<header><strong>Dashboard Suhu</strong><span id=\"ws\">WebSocket: putus</span></header>\n<main>\n  <div id=\"alert\"></div>\n  <div class=\"card row\">\n    <div><div>Suhu sekarang</div><div class=\"big\"><span id=\"temp\">--</span> &deg;C</div></div>\n    <div><div>Kelembapan</div><div class=\"big\"><span id=\"hum\">--</span> %</div></div>\n    <div><div>Batas suhu</div><div class=\"big\"><span id=\"thr\">--</span> &deg;C</div></div>\n  </div>\n  <div class=\"card row\">\n    <label>API Key <input id=\"key\" type=\"password\" placeholder=\"X-API-Key\"></label>\n    <button onclick=\"saveKey()\">Simpan &amp; muat</button>\n    <label>Batas baru <input id=\"newThr\" type=\"number\" step=\"0.5\" style=\"width:90px\"></label>\n    <button onclick=\"setThreshold()\">Set batas (PUT)</button>\n  </div>\n  <div class=\"card\"><canvas id=\"chart\" height=\"110\"></canvas></div>\n</main>\n<script>\nconst MAX_POINTS = 40;\nlet apiKey = localStorage.getItem('apiKey') || '';\ndocument.getElementById('key').value = apiKey;\n\nconst chart = new Chart(document.getElementById('chart'), {\n  type: 'line',\n  data: { labels: [], datasets: [\n    { label: 'Suhu (°C)', data: [], borderColor: '#2563eb', tension: .3, pointRadius: 2 },\n    { label: 'Batas', data: [], borderColor: '#dc2626', borderDash: [6,6], pointRadius: 0 }\n  ]},\n  options: { animation: false, scales: { y: { title: { display: true, text: '°C' } } } }\n});\n\nfunction addPoint(ts, temp, thr) {\n  chart.data.labels.push(new Date(ts).toLocaleTimeString());\n  chart.data.datasets[0].data.push(temp);\n  chart.data.datasets[1].data.push(thr);\n  if (chart.data.labels.length > MAX_POINTS) {\n    chart.data.labels.shift();\n    chart.data.datasets.forEach(d => d.data.shift());\n  }\n  chart.update();\n}\n\nfunction showReading(r) {\n  document.getElementById('temp').textContent = r.temp;\n  document.getElementById('hum').textContent = r.hum;\n  document.getElementById('thr').textContent = r.threshold;\n  addPoint(r.ts, r.temp, r.threshold);\n}\n\nfunction showAlert(a) {\n  const el = document.getElementById('alert');\n  el.textContent = '⚠ ' + a.message;\n  el.style.display = 'block';\n  clearTimeout(showAlert.t);\n  showAlert.t = setTimeout(() => el.style.display = 'none', 5000);\n  if ('Notification' in window && Notification.permission === 'granted') new Notification('Peringatan suhu', { body: a.message });\n}\n\nfunction saveKey() {\n  apiKey = document.getElementById('key').value.trim();\n  localStorage.setItem('apiKey', apiKey);\n  loadHistory();\n}\n\nasync function api(path, opts = {}) {\n  opts.headers = Object.assign({ 'X-API-Key': apiKey, 'Content-Type': 'application/json' }, opts.headers || {});\n  const res = await fetch(path, opts);\n  if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || res.status);\n  return res.json();\n}\n\nasync function loadHistory() {\n  try {\n    const thr = (await api('/api/threshold')).threshold;\n    const rows = await api('/api/history?limit=' + MAX_POINTS);\n    chart.data.labels = []; chart.data.datasets.forEach(d => d.data = []);\n    rows.forEach(r => addPoint(r.ts, r.temp, thr));\n    document.getElementById('thr').textContent = thr;\n  } catch (e) { console.warn('History gagal:', e.message); }\n}\n\nasync function setThreshold() {\n  const v = parseFloat(document.getElementById('newThr').value);\n  try { await api('/api/threshold', { method: 'PUT', body: JSON.stringify({ threshold: v }) }); }\n  catch (e) { alert('Gagal: ' + e.message); }\n}\n\nfunction connectWS() {\n  const ws = new WebSocket((location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws/suhu');\n  const badge = document.getElementById('ws');\n  ws.onopen = () => { badge.textContent = 'WebSocket: tersambung'; badge.className = 'on'; };\n  ws.onclose = () => { badge.textContent = 'WebSocket: putus'; badge.className = ''; setTimeout(connectWS, 2000); };\n  ws.onmessage = ev => {\n    const m = JSON.parse(ev.data);\n    if (m.type === 'reading') showReading(m);\n    else if (m.type === 'alert') showAlert(m);\n    else if (m.type === 'threshold') document.getElementById('thr').textContent = m.threshold;\n  };\n}\n\nif ('Notification' in window && Notification.permission === 'default') Notification.requestPermission();\nloadHistory();\nconnectWS();\n</script>\n</body>\n</html>\n",
