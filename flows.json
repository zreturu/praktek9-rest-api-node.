  {
    "id": "f_sim",
    "type": "function",
    "name": "Simulasi sensor",
    "func": "let t = flow.get(\"sim\") ?? 28;\nt += (Math.random() - 0.5) * 3;\nt = Math.max(18, Math.min(40, t));\nflow.set(\"sim\", t);\nmsg.payload = { temp: +t.toFixed(1), hum: +(50 + Math.random() * 20).toFixed(1) };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 200,
    "wires": [
      [
        "f_proc"
      ]
    ],
    "z": "tab_p9"
  },
  {
    "id": "f_proc",
    "type": "function",
    "name": "Proses pembacaan + cek threshold",
    "func": "const p = msg.payload || {};\nconst temp = Number(p.temp);\nconst hum = Number(p.hum ?? 0);\nif (!isFinite(temp)) {\n    if (msg.res) { msg.statusCode = 400; msg.payload = { error: \"Field 'temp' harus berupa angka\" }; return [null, null, null, msg]; }\n    return null;\n}\nconst thr = flow.get(\"threshold\") ?? 30;\nconst ts = new Date().toISOString();\nconst reading = { type: \"reading\", ts, temp, hum, threshold: thr, alert: temp > thr };\nflow.set(\"last\", reading);\n\nconst ins = { params: { $ts: ts, $temp: temp, $hum: hum } };       // -> SQLite\nconst wsReading = { payload: JSON.stringify(reading) };            // -> WebSocket\nlet wsAlert = null;\nif (temp > thr) {                                                  // notifikasi melewati batas\n    const message = `Suhu ${temp}\\u00B0C melewati batas ${thr}\\u00B0C`;\n    wsAlert = { payload: JSON.stringify({ type: \"alert\", ts, temp, threshold: thr, message }) };\n    node.warn(message);\n}\nlet reply = null;\nif (msg.res) { msg.statusCode = 201; msg.payload = reading; reply = msg; }  // jika dari POST /api/suhu\nreturn [ins, wsReading, wsAlert, reply];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 200,
    "wires": [
      [
        "sql_ins"
      ],
      [
        "ws_o1"
      ],
      [
        "ws_o1"
      ],
      [
        "h_post_out"
      ]
    ],
    "z": "tab_p9"
